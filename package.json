{
  "name": "dsh-side",
  "version": "1.4.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "A temporary side session for DeepSeek Harness: the product's own conversation view, the current thread inherited as one context record, and the session deleted when you close it.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "side-chat",
    "temporary-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hourglass5177/dsh-side.git"
  },
  "homepage": "https://github.com/Hourglass5177/dsh-side#readme",
  "bugs": {
    "url": "https://github.com/Hourglass5177/dsh-side/issues"
  },
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
